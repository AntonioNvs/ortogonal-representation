# Generated outputs — do not commit regenerable artifacts
output/skill_exports/
output/plots/
output/skill_model/*.pth
output/skill_model/*.pt
output/career_validation/
output/skill_evaluation/
output/models/
output/significance*/
output/temporal_curve*/
output/runs/
output/shap_encoder*
output/impact_analysis*
output/skill_rankings/
output/sensitivity_grid/
notebooks/output/

# Keep directory structure
!output/.gitkeep
!output/plots/.gitkeep
!output/skill_exports/.gitkeep

# Python / env
/venv
/cache
**/__pycache__/
*.pyc
*.pyo
.env
*.out
train.txt
.pytest_cache/
*.ipynb_checkpoints/

# Parquet by default; ship the enriched RelBench DB explicitly
*.parquet
!data/enriched/rel-f1/db/*.parquet
!data/enriched/rel-f1/*.parquet

# Raw snapshots (rebuild via pipeline)
data/raw/f1db/*
data/raw/jolpica/*
!data/raw/f1db/.gitkeep
!data/raw/jolpica/.gitkeep

# AI / agent tooling (local-only, never commit)
.cursor/
.claude/
CLAUDE.md
AGENTS.md
.aider*
.aider/
